---
import Baza from '../../../layouts/Baza.astro';
import Catalog from '../../../components/Catalog.astro';
import { getCategorii, getProduse, slugCategorie, urlCategorie, type Categorie } from '../../../lib/date';
import { schemaFirimituri } from '../../../lib/schema';

export async function getStaticPaths() {
	const categorii = await getCategorii();
	return categorii.map((c) => ({ params: { categorie: c.slug }, props: { categorie: c } }));
}

const { categorie } = Astro.props as { categorie: Categorie };
const toate = await getProduse();
const categorii = await getCategorii();
const produse = toate.filter((p) => slugCategorie(p) === categorie.slug);

const pasi = [
	{ nume: 'Acasă', url: '/' },
	{ nume: 'Produse', url: '/produse/' },
	{ nume: categorie.nume, url: urlCategorie(categorie.slug) },
];
const descriere = categorie.descriere || `Modelele de ${categorie.nume.toLowerCase()} disponibile la noi, cu dimensiuni și culori.`;
---

<Baza titlu={`${categorie.nume} – Berceni, Ilfov`} descriere={`${descriere} Cere ofertă online.`} schema={[schemaFirimituri(Astro.site!, pasi)]}>
	<Catalog
		titlu={categorie.nume}
		descriere={descriere}
		produse={produse}
		toateProdusele={toate}
		categorii={categorii}
		activ={categorie.slug}
		pasi={pasi}
	/>
</Baza>

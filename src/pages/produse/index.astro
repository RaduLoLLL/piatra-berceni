---
import Baza from '../../layouts/Baza.astro';
import Catalog from '../../components/Catalog.astro';
import { getCategorii, getProduse } from '../../lib/date';
import { schemaFirimituri } from '../../lib/schema';

const produse = await getProduse();
const categorii = await getCategorii();
const pasi = [
	{ nume: 'Acasă', url: '/' },
	{ nume: 'Produse', url: '/produse/' },
];
const numeCategorii = categorii.map((c) => c.nume.toLowerCase()).join(', ');
---

<Baza
	titlu="Produse"
	descriere={`Catalogul complet: ${numeCategorii}. Vezi dimensiunile, culorile și cere ofertă.`}
	schema={[schemaFirimituri(Astro.site!, pasi)]}
>
	<Catalog
		titlu="Toate produsele"
		descriere="Alege o categorie din stânga sau filtrează după grosime și culoare."
		produse={produse}
		toateProdusele={produse}
		categorii={categorii}
		pasi={pasi}
	/>
</Baza>

---
import Baza from '../layouts/Baza.astro';
import CapPagina from '../components/CapPagina.astro';
import Icon from '../components/Icon.astro';
import { servicii, urlOferta } from '../lib/date';
import { schemaFirimituri } from '../lib/schema';

const pasi = [
	{ nume: 'Acasă', url: '/' },
	{ nume: 'Servicii', url: '/servicii/' },
];
---

<Baza titlu="Servicii" descriere={servicii.intro} schema={[schemaFirimituri(Astro.site!, pasi)]}>
	<CapPagina titlu="Servicii" lead={servicii.intro} pasi={pasi} />
	<div class="container sectiune">
		<ol class="servicii">
			{
				servicii.servicii.map((s) => (
					<li>
						<h2>{s.titlu}</h2>
						<p class="text-secundar">{s.text}</p>
					</li>
				))
			}
		</ol>
		<a class="buton" href={urlOferta()}><Icon nume="oferta" /> Cere ofertă</a>
	</div>
</Baza>

<style>
	.servicii {
		display: grid;
		gap: 16px;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		margin: 0 0 40px;
		padding: 0;
		list-style: none;
		counter-reset: serviciu;
	}
	.servicii li {
		padding: 28px;
		background: var(--suprafata);
		border-top: 3px solid var(--accent);
		counter-increment: serviciu;
	}
	.servicii li::before {
		content: counter(serviciu, decimal-leading-zero);
		display: block;
		margin-bottom: 12px;
		color: var(--accent);
		font-family: var(--titlu);
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1;
	}
	.servicii h2 {
		font-size: 1.625rem;
	}
	.servicii p {
		margin: 0;
	}
</style>

---
import Baza from '../layouts/Baza.astro';
import { getCategorii, urlCategorie } from '../lib/date';
const categorii = await getCategorii();
---

<Baza titlu="Pagina nu a fost găsită" descriere="Pagina căutată nu există." faraIndexare>
	<div class="container sectiune">
		<h1>Pagina nu a fost găsită</h1>
		<p class="lead">Este posibil ca produsul să fi fost mutat sau scos din catalog. Încearcă una dintre categoriile de mai jos.</p>
		<ul>
			{
				categorii.map((c) => (
					<li>
						<a href={urlCategorie(c.slug)}>{c.nume}</a>
					</li>
				))
			}
			<li><a href="/contact/">Contact</a></li>
		</ul>
	</div>
</Baza>

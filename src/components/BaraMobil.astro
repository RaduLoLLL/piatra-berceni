---
// Bara fixă de jos, doar pe telefon: cele trei acțiuni pe care le caută aproape orice vizitator.
import Icon from './Icon.astro';
import { firma, linkWhatsapp, urlOferta } from '../lib/date';

const whatsapp = linkWhatsapp('Bună ziua, aș dori o ofertă pentru ');
---

<nav class="bara" aria-label="Contact rapid">
	<a href={`tel:${firma.telefon_link}`}>
		<Icon nume="telefon" />
		Sună
	</a>
	{
		whatsapp && (
			<a href={whatsapp} rel="noopener">
				<Icon nume="chat" />
				WhatsApp
			</a>
		)
	}
	<a href={firma.link_google_maps} rel="noopener">
		<Icon nume="pin" />
		Traseu
	</a>
	<a class="bara__oferta" href={urlOferta()}>
		<Icon nume="oferta" />
		Ofertă
	</a>
</nav>

<style>
	.bara {
		position: fixed;
		inset: auto 0 0 0;
		z-index: 50;
		display: flex;
		height: calc(var(--inaltime-bara) + env(safe-area-inset-bottom));
		padding-bottom: env(safe-area-inset-bottom);
		background: var(--piatra);
		box-shadow: 0 -2px 12px rgb(0 0 0 / 0.15);
	}
	.bara a {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		color: var(--piatra-text);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
	}
	.bara a + a {
		border-left: 1px solid rgb(255 255 255 / 0.08);
	}
	.bara svg {
		width: 22px;
		height: 22px;
	}
	.bara .bara__oferta {
		background: var(--accent);
		color: var(--accent-text);
	}
	@media (min-width: 768px) {
		.bara {
			display: none;
		}
	}
</style>

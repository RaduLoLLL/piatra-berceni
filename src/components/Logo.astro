---
import { firma } from '../lib/date';
interface Props {
	deschis?: boolean;
}
const { deschis = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--deschis': deschis }]} aria-label={`${firma.nume_scurt} – prima pagină`}>
	<svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
		<rect x="2" y="4" width="13" height="7" rx="1" fill="#b8402a"></rect>
		<rect x="17" y="4" width="13" height="7" rx="1" fill="currentColor"></rect>
		<rect x="2" y="13" width="6" height="7" rx="1" fill="currentColor"></rect>
		<rect x="10" y="13" width="13" height="7" rx="1" fill="currentColor"></rect>
		<rect x="25" y="13" width="5" height="7" rx="1" fill="#b8402a"></rect>
		<rect x="2" y="22" width="13" height="7" rx="1" fill="currentColor"></rect>
		<rect x="17" y="22" width="13" height="7" rx="1" fill="currentColor"></rect>
	</svg>
	<span>{firma.nume_scurt}</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--text);
		font-family: var(--titlu);
		font-size: 1.625rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
	}
	.logo:hover {
		color: var(--text);
	}
	.logo--deschis,
	.logo--deschis:hover {
		color: var(--piatra-text);
	}
	svg {
		flex: none;
	}
</style>

---
import { firma } from '../lib/date';
interface Props {
	deschis?: boolean;
}
const { deschis = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--deschis': deschis }]} aria-label={`${firma.nume_scurt} – prima pagină`}>
	<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
		<rect x="2" y="4" width="13" height="7" rx="1.5" fill="#b3432a"></rect>
		<rect x="17" y="4" width="13" height="7" rx="1.5" fill="currentColor"></rect>
		<rect x="2" y="13" width="6" height="7" rx="1.5" fill="currentColor"></rect>
		<rect x="10" y="13" width="13" height="7" rx="1.5" fill="currentColor"></rect>
		<rect x="25" y="13" width="5" height="7" rx="1.5" fill="#b3432a"></rect>
		<rect x="2" y="22" width="13" height="7" rx="1.5" fill="currentColor"></rect>
		<rect x="17" y="22" width="13" height="7" rx="1.5" fill="currentColor"></rect>
	</svg>
	<span>{firma.nume_scurt}</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		font-size: 1.1875rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.logo:hover {
		color: var(--text);
	}
	.logo--deschis,
	.logo--deschis:hover {
		color: var(--piatra-text);
	}
	svg {
		flex: none;
	}
</style>

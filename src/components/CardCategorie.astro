---
// Panou înalt cu fotografie și numele categoriei peste ea (stilul „Produsele noastre” de la site-urile de referință).
import Imagine from './Imagine.astro';
import { slugCategorie, urlCategorie, type Categorie, type Produs } from '../lib/date';
import { modelCategorie } from '../lib/vizual';

interface Props {
	categorie: Categorie;
	produse: Produs[];
}
const { categorie, produse } = Astro.props;
const dinCategorie = produse.filter((p) => slugCategorie(p) === categorie.slug);
const foto = categorie.imagine ?? dinCategorie.find((p) => p.data.imagini.length)?.data.imagini[0];
---

<a class="categorie" href={urlCategorie(categorie.slug)}>
	<Imagine
		foto={foto}
		model={modelCategorie(categorie, produse)}
		alt=""
		sizes="(min-width: 1280px) 320px, (min-width: 768px) 25vw, 50vw"
		class="categorie__imagine"
	/>
	<span class="categorie__text">
		<span class="categorie__numar">{dinCategorie.length} {dinCategorie.length === 1 ? 'produs' : 'produse'}</span>
		<span class="categorie__nume">{categorie.nume}</span>
		<span class="categorie__vezi">Vezi produsele →</span>
	</span>
</a>

<style>
	.categorie {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		background: var(--piatra);
		color: #fff;
		text-decoration: none;
	}
	.categorie :global(.categorie__imagine) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}
	.categorie::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(0 0 0 / 0) 35%, rgb(0 0 0 / 0.72) 100%);
	}
	.categorie:hover {
		color: #fff;
	}
	.categorie:hover :global(.categorie__imagine) {
		transform: scale(1.05);
	}
	.categorie__text {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: clamp(16px, 2vw, 28px);
	}
	.categorie__numar,
	.categorie__vezi {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.categorie__numar {
		opacity: 0.8;
	}
	.categorie__nume {
		font-family: var(--titlu);
		font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
	}
	.categorie__vezi {
		margin-top: 8px;
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.2s, transform 0.2s;
	}
	.categorie:hover .categorie__vezi,
	.categorie:focus-visible .categorie__vezi {
		opacity: 1;
		transform: none;
	}
	@media (hover: none) {
		.categorie__vezi {
			opacity: 1;
			transform: none;
		}
	}
</style>

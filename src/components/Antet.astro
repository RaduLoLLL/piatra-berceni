---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { firma, urlOferta } from '../lib/date';

const legaturi = [
	{ href: '/produse/', text: 'Produse' },
	{ href: '/lucrari/', text: 'Lucrări' },
	{ href: '/servicii/', text: 'Servicii' },
	{ href: '/despre/', text: 'Despre' },
	{ href: '/contact/', text: 'Contact' },
];
const cale = Astro.url.pathname;
const activ = (href: string) => cale === href || cale.startsWith(href);
---

<header class="antet">
	<div class="container antet__rand">
		<Logo />
		<nav class="antet__nav" aria-label="Meniu principal">
			<ul>
				{
					legaturi.map((l) => (
						<li>
							<a href={l.href} aria-current={activ(l.href) ? 'page' : undefined}>
								{l.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="antet__actiuni">
			<a class="antet__telefon" href={`tel:${firma.telefon_link}`}>
				<Icon nume="telefon" />
				{firma.telefon}
			</a>
			<a class="buton" href={urlOferta()}>Cere ofertă</a>
		</div>
	</div>
</header>

<style>
	.antet {
		background: var(--suprafata);
		border-bottom: 1px solid var(--linie);
	}
	.antet__rand {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0 24px;
		padding-top: 12px;
	}
	.antet__nav {
		grid-column: 1 / -1;
		/* Pe telefon meniul e mereu vizibil, pe un rând care se poate derula lateral. Fără meniu ascuns. */
		overflow-x: auto;
		scrollbar-width: none;
		margin-inline: calc(var(--margine) * -1);
		padding-inline: var(--margine);
	}
	.antet__nav::-webkit-scrollbar {
		display: none;
	}
	.antet__nav ul {
		display: flex;
		gap: 2px;
		margin: 0 0 0 -8px;
		padding: 0;
		list-style: none;
	}
	.antet__nav a {
		display: block;
		padding: 12px 8px;
		color: var(--text);
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 3px solid transparent;
	}
	.antet__nav a:hover {
		color: var(--accent);
	}
	.antet__nav a[aria-current='page'] {
		border-bottom-color: var(--accent);
	}
	.antet__actiuni {
		display: none;
	}

	@media (min-width: 960px) {
		.antet__rand {
			grid-template-columns: auto 1fr auto;
			padding-top: 0;
		}
		.antet__nav {
			grid-column: auto;
			margin: 0;
			padding: 0;
		}
		.antet__nav ul {
			justify-content: center;
			margin-left: 0;
		}
		.antet__nav a {
			padding: 26px 10px 23px;
		}
		.antet__actiuni {
			display: flex;
			align-items: center;
			gap: 20px;
		}
		.antet__telefon {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: var(--text);
			font-weight: 700;
			text-decoration: none;
			white-space: nowrap;
		}
		.antet__telefon svg {
			width: 18px;
			color: var(--accent);
		}
	}
</style>

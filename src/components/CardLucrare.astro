---
import Imagine from './Imagine.astro';
import type { Lucrare } from '../lib/date';
import { modelLucrare } from '../lib/vizual';

interface Props {
	lucrare: Lucrare;
	mare?: boolean;
}
const { lucrare, mare = false } = Astro.props;
const d = lucrare.data;
const luna = new Intl.DateTimeFormat('ro-RO', { month: 'long', year: 'numeric' }).format(d.data);
---

<a class:list={['lucrare', { 'lucrare--mare': mare }]} href={`/lucrari/${lucrare.id}/`}>
	<Imagine
		foto={d.imagini[0]}
		model={modelLucrare(lucrare)}
		alt={d.imagini[0] ? d.titlu : ''}
		sizes={mare ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 40vw, 100vw'}
		class="lucrare__imagine"
	/>
	<div class="lucrare__text">
		{d.exemplu && <span class="eticheta-exemplu">Exemplu</span>}
		<span class="lucrare__loc">{d.localitate} · {luna}{d.suprafata_mp && ` · ${d.suprafata_mp} m²`}</span>
		<h3>{d.titlu}</h3>
	</div>
</a>

<style>
	.lucrare {
		position: relative;
		display: block;
		overflow: hidden;
		text-decoration: none;
		min-height: 320px;
		background: var(--piatra);
		color: #fff;
	}
	.lucrare :global(.lucrare__imagine) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}
	.lucrare::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(0 0 0 / 0) 30%, rgb(0 0 0 / 0.75) 100%);
	}
	.lucrare:hover :global(.lucrare__imagine) {
		transform: scale(1.04);
	}
	.lucrare__text {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 1;
		padding: clamp(18px, 2.5vw, 32px);
	}
	.lucrare__loc {
		display: block;
		margin: 8px 0 6px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.85;
	}
	h3 {
		margin: 0;
		font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
		max-width: 22ch;
	}
	.lucrare--mare h3 {
		font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
	}
	.lucrare:hover {
		color: #fff;
	}
</style>

---
import Imagine from './Imagine.astro';
import { formatPret, urlProdus, type Produs } from '../lib/date';
import { NUME_CULORI, CULORI } from '../lib/constante';
import { modelProdus } from '../lib/vizual';

interface Props {
	produs: Produs;
}
const { produs } = Astro.props;
const d = produs.data;
const pret = formatPret(produs);
---

<article
	class="card"
	data-culori={d.culori.join('|')}
	data-grosime={d.grosime_cm ?? ''}
>
	<Imagine
		foto={d.imagini[0]}
		model={modelProdus(produs)}
		alt={d.imagini[0] ? d.nume : ''}
		sizes="(min-width: 1240px) 280px, (min-width: 600px) 45vw, 100vw"
		class="card__imagine"
	/>
	<div class="card__corp">
		<h3><a href={urlProdus(produs)}>{d.nume}</a></h3>
		<p class="card__rezumat">{d.rezumat}</p>
		<ul class="card__detalii">
			{d.grosime_cm && <li>{d.grosime_cm} cm</li>}
			{d.dimensiuni && <li>{d.dimensiuni}</li>}
		</ul>
		<div class="card__jos">
			{
				d.culori.length > 0 && (
					<ul class="card__culori" aria-label="Culori disponibile">
						{d.culori.map((c) => (
							<li style={`--c:${CULORI[c] ?? '#999'}`} title={NUME_CULORI[c] ?? c}>
								<span class="sr-only">{NUME_CULORI[c] ?? c}</span>
							</li>
						))}
					</ul>
				)
			}
			<span class="card__pret">{pret ?? 'Preț la cerere'}</span>
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--suprafata);
		border: 1px solid var(--linie);
		border-radius: var(--raza);
		overflow: hidden;
		transition: box-shadow 0.15s, transform 0.15s;
	}
	.card:hover {
		box-shadow: var(--umbra);
		transform: translateY(-2px);
	}
	.card[hidden] {
		display: none;
	}
	.card :global(.card__imagine) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: var(--suprafata-2);
	}
	.card__corp {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 16px 18px 18px;
	}
	h3 {
		margin-bottom: 6px;
	}
	h3 a {
		color: var(--text);
		text-decoration: none;
	}
	/* Toată fișa e clicabilă, dar linkul rămâne unul singur (bun pentru cititoarele de ecran). */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card__rezumat {
		color: var(--text-2);
		font-size: 0.9375rem;
		margin-bottom: 12px;
	}
	.card__detalii {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0 0 14px;
		padding: 0;
		list-style: none;
	}
	.card__detalii li {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--suprafata-2);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.card__jos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
	}
	.card__culori {
		display: flex;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card__culori li {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
	}
	.card__pret {
		margin-left: auto;
		font-weight: 700;
		font-size: 0.9375rem;
		white-space: nowrap;
	}
</style>

---
import Imagine from './Imagine.astro';
import { formatPret, slugify, urlProdus, type Produs } from '../lib/date';
import { NUME_CULORI, CULORI } from '../lib/constante';
import { modelProdus } from '../lib/vizual';

interface Props {
	produs: Produs;
	/** Prima fotografie a paginii: se încarcă imediat. */
	prioritar?: boolean;
}
const { produs, prioritar = false } = Astro.props;
const d = produs.data;
const pret = formatPret(produs);
const detalii = [d.grosime_cm && `${d.grosime_cm} cm`, d.dimensiuni].filter(Boolean).join(' · ');
// Textul după care filtrează căutarea de pe site (fără diacritice, litere mici).
const textCautare = slugify([d.nume, d.categorie, d.rezumat, d.dimensiuni, d.utilizare, ...d.culori.map((c) => NUME_CULORI[c] ?? c)].join(' ')).replace(/-/g, ' ');
---

<article class="card" data-culori={d.culori.join('|')} data-grosime={d.grosime_cm ?? ''} data-cauta={textCautare}>
	<div class="card__media">
		<Imagine
			foto={d.imagini[0]}
			model={modelProdus(produs)}
			alt={d.imagini[0] ? d.nume : ''}
			sizes="(min-width: 1280px) 300px, (min-width: 600px) 30vw, 50vw"
			prioritar={prioritar}
			class="card__imagine"
		/>
	</div>
	<div class="card__corp">
		<span class="card__categorie">{d.categorie}</span>
		<h3><a href={urlProdus(produs)}>{d.nume}</a></h3>
		{detalii && <p class="card__detalii">{detalii}</p>}
		<div class="card__jos">
			<span class="card__pret">{pret ?? 'Preț la cerere'}</span>
			{
				d.culori.length > 0 && (
					<ul class="card__culori" aria-label="Culori disponibile">
						{d.culori.map((c) => (
							<li style={`--c:${CULORI[c] ?? '#999'}`} title={NUME_CULORI[c] ?? c}>
								<span class="sr-only">{NUME_CULORI[c] ?? c}</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.card[hidden] {
		display: none;
	}
	.card__media {
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background: var(--suprafata-2);
	}
	.card :global(.card__imagine) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}
	.card:hover :global(.card__imagine) {
		transform: scale(1.04);
	}
	.card__corp {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding-top: 14px;
	}
	.card__categorie {
		color: var(--text-2);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h3 {
		margin: 4px 0 4px;
		font-family: var(--font);
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0;
		text-transform: none;
	}
	h3 a {
		color: var(--text);
		text-decoration: none;
	}
	/* Toată fișa e clicabilă, dar linkul rămâne unul singur (bun pentru cititoarele de ecran). */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card:hover h3 a {
		color: var(--accent);
	}
	.card__detalii {
		margin: 0 0 10px;
		color: var(--text-2);
		font-size: 0.875rem;
	}
	.card__jos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 10px;
		border-top: 1px solid var(--linie);
	}
	.card__pret {
		font-size: 0.875rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.card__culori {
		display: flex;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card__culori li {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
	}
</style>
